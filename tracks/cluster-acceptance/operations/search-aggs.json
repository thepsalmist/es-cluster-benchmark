{
  "name": "search-aggs",
  "operation-type": "search",
  "index": "{{ index_name | default('rally-acceptance') }}",
  "body": {
    "size": 0,
    "track_total_hits": true,
    "query": {
      "range": {
        "@timestamp": {
          "gte": "{{ query_date_gte | default('2026-01-15') }}",
          "lte": "{{ query_date_lte | default('2026-03-15') }}"
        }
      }
    },
    "aggs": {
      "per_day": {
        "date_histogram": {
          "field": "@timestamp",
          "calendar_interval": "day"
        }
      },
      "by_service": {
        "terms": {
          "field": "service",
          "size": 12
        }
      },
      "latency": {
        "percentiles": {
          "field": "duration_ms",
          "percents": [50, 90, 99]
        }
      }
    }
  }
}
